# ---- Segredos: nunca versionar ----
include/secrets.h
**/secrets.h
**/secrets.local.*
*.key
*.pem

# ---- Build embarcado ----
.pio/
.pioenvs/
.piolibdeps/
build/
*.elf
*.bin
*.hex
*.map
compile_commands.json

# ---- VS Code (o que a maquina gera, nao o que o projeto declara) ----
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/.browse.c_cpp.db*

# ---- Evidencias de bancada (pesadas e volateis) ----
evidencias/**/*.jpg
evidencias/**/*.png
evidencias/**/*.mp4
evidencias/**/*.wav
!evidencias/**/.gitkeep

# ---- Marcos: a excecao, e ela e deliberada ----
# `evidencias/` inteiro e ignorado porque enche de captura repetida e
# pesada. Mas ha imagens que SAO a prova de que uma etapa aconteceu - a
# primeira foto de uma camera nao se repete, e uma etapa provada por um
# arquivo que nao esta no repositorio nao esta provada para ninguem.
# Entram poucas, escolhidas, e cada uma e citada em documento.
!evidencias/marcos/
!evidencias/marcos/*.jpg
!evidencias/marcos/*.png

# ---- CAD / fabricacao ----
*.3mf
*.gcode
*-bak.*
*-backups/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.venv-host/

# ---- Estado de trabalho entre sessoes (pessoal, nao e documentacao) ----
CONTEXTO.md

# ---- Sistema operacional ----
Thumbs.db
desktop.ini
ehthumbs.db
*.tmp
*.log
